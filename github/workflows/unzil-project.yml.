name: Extract Najah Retail Project

on:
  push:
    branches: ["main"]
    paths:
      - "najah-retail-project.zip"
      - ".github/workflows/unzip-project.yml"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  unzip-project:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Unzip project files into repository root
        run: |
          mkdir -p extracted-project
          unzip -o "najah-retail-project.zip" -d extracted-project
          shopt -s dotglob
          cp -r extracted-project/* .
          rm -rf extracted-project
          git status --short

      - name: Commit extracted project files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git diff --cached --quiet || git commit -m "Extract project files from zip"
          git push
